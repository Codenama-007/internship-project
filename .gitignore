!.env.example
*.pem
*.key

# --- data / databases (phase 2 data lake) ---
*.db
*.sqlite
*.sqlite3

# --- logs & os ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db

# --- editors ---
.vscode/
.idea/
